# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
#
# All variables use the HORNET_ prefix (read by pydantic-settings).

# ---- Database ----
# Matches the docker-compose.yml Postgres instance.
HORNET_DB_URL=postgresql+psycopg://hornet:hornet@localhost:5432/hornet

# ---- Environment ----
HORNET_ENV=development
HORNET_LOG_LEVEL=INFO

# ---- API server ----
HORNET_API_HOST=127.0.0.1
HORNET_API_PORT=8000

# ---- Data source API keys ----
# Get a free FRED key at: https://fred.stlouisfed.org/docs/api/api_key.html
HORNET_FRED_API_KEY=

# ---- LLM provider credentials ----
# Anthropic API key for Claude provider (ESCALATE rationales, paid-tier queries)
HORNET_ANTHROPIC_API_KEY=
# Optional: API key for OpenAI-compatible provider (vLLM, LM Studio, etc.)
HORNET_OPENAI_API_KEY=
