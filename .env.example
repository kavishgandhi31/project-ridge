# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# ---- Database ----
# Matches the docker-compose.yml Postgres instance.
HORNET_DB_URL=postgresql+psycopg://hornet:hornet@localhost:5432/hornet

# ---- Environment ----
HORNET_ENV=development
HORNET_LOG_LEVEL=INFO

# ---- API server ----
HORNET_API_HOST=127.0.0.1
HORNET_API_PORT=8000

# ---- Data source API keys (add as adapters come online) ----
FRED_API_KEY=

# ---- LLM providers (Phase 7) ----
ANTHROPIC_API_KEY=
HORNET_OLLAMA_BASE_URL=http://localhost:11434
HORNET_LOCAL_LLM_MODEL=qwen3:14b-q4_K_M
