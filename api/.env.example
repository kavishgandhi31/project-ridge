# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
#
# All variables use the RIDGE_ prefix (read by pydantic-settings).

# ---- Database ----
# Matches the docker-compose.yml Postgres instance.
RIDGE_DB_URL=postgresql+psycopg://ridge:ridge@localhost:5432/ridge

# ---- Environment ----
RIDGE_ENV=development
RIDGE_LOG_LEVEL=INFO

# ---- API server ----
RIDGE_API_HOST=127.0.0.1
RIDGE_API_PORT=8000

# ---- Data source API keys ----
# Get a free FRED key at: https://fred.stlouisfed.org/docs/api/api_key.html
RIDGE_FRED_API_KEY=

# ---- LLM provider credentials ----
# Anthropic API key for Claude provider (ESCALATE rationales, paid-tier queries)
RIDGE_ANTHROPIC_API_KEY=
# Optional: API key for OpenAI-compatible provider (vLLM, LM Studio, etc.)
RIDGE_OPENAI_API_KEY=
